  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Abilities Full Descriptions_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: edb7705e557df994e9951bce9b47d09a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 92384944128
    m_Localized: 'Spend all AP. Gain {delta_value} block and {alternative_delta_value}
      armor for each spended AP.


      Gain {calculated_block_value} block and
      {calculated_armor_value} armor.{block_subhint}

      {armor_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 4971610398720
    m_Localized: 'Move to the selected cell near the selected unit and hit it with
      the selected weapon.


      Damage of the selected weapon is {calculated_damage_value}.


      It
      costs {value_2} AP if the selected weapon is heavy. Otherwise it costs {value}
      AP.'
    m_Metadata:
      m_Items: []
  - m_Id: 12759103332352
    m_Localized: 'Move the selected unit to the selected cell.


      The available
      area is selected in a straight line from the back of the user.'
    m_Metadata:
      m_Items: []
  - m_Id: 16880787152896
    m_Localized: Units within a radius of {range} around the owner lose {strength_effect_value}
      strength for {strength_effect_time} turns.{strength_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 21818456039424
    m_Localized: Destroy a blood surface and deal {calculated_damage_value} damage
      to an area within a radius of {alternative_range} around it.
    m_Metadata:
      m_Items: []
  - m_Id: 29700035600384
    m_Localized: 'Move to the selected cell and deal {calculated_damage_value} damage
      to an area within a radius of {alternative_range} around it. '
    m_Metadata:
      m_Items: []
  - m_Id: 33484681928704
    m_Localized: Destroy the blood surface and take away {defence_effect_value} defence
      from units around it within a radius of {alternative_range} for {defence_effect_time}
      turns.{defence_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 41120936648704
    m_Localized: Deal {calculated_damage_value} damage and take away {defence_effect_value}
      defence for {defence_effect_time} turns.{defence_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 45186194497536
    m_Localized: Lose {health_points_cost} health. Deal {calculated_damage_value}
      damage to the selected cone area with a range of {range}.
    m_Metadata:
      m_Items: []
  - m_Id: 50025121079296
    m_Localized: Deal {calculated_damage_value} damage.
    m_Metadata:
      m_Items: []
  - m_Id: 51412550705152
    m_Localized: Units within a radius of {range} around the owner lose {defence_effect_value}
      defence for {defence_effect_time} turns.{defence_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 52893983072256
    m_Localized: Show information.
    m_Metadata:
      m_Items: []
  - m_Id: 53886443479040
    m_Localized: Move to a selected cell.
    m_Metadata:
      m_Items: []
  - m_Id: 54945815617536
    m_Localized: Move the selected unit to the next cell, if it's possible.
    m_Metadata:
      m_Items: []
  - m_Id: 57220751581184
    m_Localized: 'Deal {calculated_damage_value} damage. It ricochets to the nearest
      target up to {count} times. The ricochet range is {alternative_range}.


      Does
      not hit the same target twice.


      It can ricochet into the user.'
    m_Metadata:
      m_Items: []
  - m_Id: 59943286890496
    m_Localized: Lose {health_points_cost} health. Gain {strength_effect_value} strength
      for {strength_effect_time} turns.{strength_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 64184667758592
    m_Localized: Lose {action_point_regeneration_penalty} AP regeneration for 1 turn.
      Gain {dexterity_effect_value} dexterity for {dexterity_effect_time} turns.{dexterity_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 67385580216320
    m_Localized: Lose {defence_effect_value} defence and gain {intelligence_effect_value}
      intelligence for {intelligence_effect_time} turns.{intelligence_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 69704657035264
    m_Localized: Movement stops spending AP for 1 turn. Each move takes away {value}
      health for 1 turn.
    m_Metadata:
      m_Items: []
  - m_Id: 73665321525248
    m_Localized: Gain {calculated_block_value} block.{block_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 75398437298176
    m_Localized: 'Jump over the cell. Gain {calculated_block_value} block.


      Isn''t
      able to jump over the cell with a big unit.{block_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 78676654972928
    m_Localized: Gain {calculated_armor_value} armor.{armor_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 79585032167424
    m_Localized: Lose {health_points_cost} health.
    m_Metadata:
      m_Items: []
  - m_Id: 83247578112000
    m_Localized: Move to the selected cell in a straight line. It is able to move
      through units. Deal {calculated_damage_value} damage to these units.
    m_Metadata:
      m_Items: []
  - m_Id: 119588181401600
    m_Localized: Apply {immobilized_effect_time} immobilized.{immobolized_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 121253257175040
    m_Localized: Gain {thorns_effect_value} thorns.{thorns_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 123377726676992
    m_Localized: The thorns effect will last for {thorns_effect_time} turns.
    m_Metadata:
      m_Items: []
  - m_Id: 124068897644544
    m_Localized: The thorns effect weakens by {thorns_effect_delta} per turn.
    m_Metadata:
      m_Items: []
  - m_Id: 128924710494208
    m_Localized: Move in the selected direction.
    m_Metadata:
      m_Items: []
  - m_Id: 131009275387904
    m_Localized: 'Deal {calculated_damage_value} damage to unit on crash into it.


      The
      damage value ignores the owner''s strength.


      The damage value is equal
      to the sum of block, armor and thorns multiplied by 1.5.{block_subhint}{armor_subhint}{thorns_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 148197700952064
    m_Localized: Make a blood surface on the selected cell. Take away {strength_effect_value}
      strength for {strength_effect_time} turns from the unit on the selected cell.{strength_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 150552668430336
    m_Localized: '


      The damage value ignores the owner''s strength.


      Deals
      {delta_value} for each {step_value} maximum health points.'
    m_Metadata:
      m_Items: []
  - m_Id: 157227844526080
    m_Localized: Deal {calculated_damage_value} damage to the selected area.
    m_Metadata:
      m_Items: []
  - m_Id: 157780569907200
    m_Localized: Selected area is the straight line with a range {range}.
    m_Metadata:
      m_Items: []
  - m_Id: 158079355346944
    m_Localized: Selected area is the straight line with no range limits.
    m_Metadata:
      m_Items: []
  - m_Id: 162612949180416
    m_Localized: '


      The damage is equal to the damage of the selected weapon.


      The
      cooldown is {value_2} if the selected weapon is heavy. Otherwise the coldown
      is {value}.{heavy_weapon_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 166497961009152
    m_Localized: Take away {strength_effect_value} strength for {strength_effect_time}
      turns.{strength_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 166901453053952
    m_Localized: The strength effect weakens by {strength_effect_delta} per turn.
    m_Metadata:
      m_Items: []
  - m_Id: 359330307268608
    m_Localized: Gain {max_hp_mod} maximum health.
    m_Metadata:
      m_Items: []
  - m_Id: 359352637743104
    m_Localized: Lose {max_hp_mod} maximum health.
    m_Metadata:
      m_Items: []
  - m_Id: 360029107675136
    m_Localized: Gain {strength_effect_value} strength.{strength_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 360049441660928
    m_Localized: Lose {strength_effect_value} strength.{strength_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 360089417572352
    m_Localized: Gain {intelligence_effect_value} intelligence.{intelligence_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 360128139386880
    m_Localized: Lose {intelligence_effect_value} intelligence.{intelligence_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 360154739662848
    m_Localized: Gain {dexterity_effect_value} dexterity.{dexterity_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 363650041929728
    m_Localized: Lose {dexterity_effect_value} dexterity.{dexterity_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 363780505755648
    m_Localized: Gain {defence_effect_value} defence.{defence_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 364031283191808
    m_Localized: Lose {defence_effect_value} defence.{defence_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 369106311340032
    m_Localized: Gain {strength_effect_value} for each {count} movements. The effect
      is reset at the end of the turn.{strength_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 369781434900480
    m_Localized: Gain {count} charge of escape from death.{escape_from_death_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 376720130727936
    m_Localized: Gain {value} temporary AP, if turn is ended nearby enemy.{temporary_action_points_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 377916178456576
    m_Localized: Give {calculated_armor_value} armor and {calculated_block_value}
      block on contact.{contact_subhint}{armor_subhint}{block_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 383550806450176
    m_Localized: Spawn a bite-bug within a radius of {range} on death.
    m_Metadata:
      m_Items: []
  - m_Id: 386828466282496
    m_Localized: 'Take away {defence_effect_value} defence for {defence_effect_time}
      turns for the first attacker during the turn.


      It only works if the
      attacker doesn''t destroy block.{defence_decreased_subhint}{block_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 391054584078336
    m_Localized: Deal {value} damage to nearby enemies when the owner gains block
      or armor.{armor_subhint}{block_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 392611656523776
    m_Localized: Deal {value} damage to target on contact.{contact_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 396580730593280
    m_Localized: "Increase weapon damage by {value}%. \n\nDoesn't work with an alternative
      damage of the weapon.\n\nDoesn't work with a crossbow shot."
    m_Metadata:
      m_Items: []
  - m_Id: 399689355780096
    m_Localized: 'Each movement deals {calculated_damage_value} damage to enemies
      nearby.


      Deals {delta_value} damage for each {step_value} maximum health
      points.


      It doesn''t trigger thorns.{thorns_subhint}


      It doesn''t
      make rats run away.

'
    m_Metadata:
      m_Items: []
  - m_Id: 406194905833472
    m_Localized: 'Heal {value} health per turn.


      It doesn''t work in peaceful
      rooms.


      It doesn''t work when the exit from the battle room is open.'
    m_Metadata:
      m_Items: []
  - m_Id: 408272462045184
    m_Localized: Gain {value} temporary AP, if owner hasn't moved during the turn.{temporary_action_points_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 409067790163968
    m_Localized: Increase the radius of the picking up blood surfaces by {range}.
    m_Metadata:
      m_Items: []
  - m_Id: 410663563452416
    m_Localized: 'Lose {strength_effect_value} strength.


      Gain {value} strength
      for each rat on the battlefield besides the owner.{strength_increased_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 432298551042048
    m_Localized: Gain additional {value} hp for each rest.
    m_Metadata:
      m_Items: []
  - m_Id: 433546289373184
    m_Localized: Make rats think that there are more of them on the battlefield.
    m_Metadata:
      m_Items: []
  - m_Id: 437362413953024
    m_Localized: 'Move from a source of damage.


      It is triggered once per
      turn.'
    m_Metadata:
      m_Items: []
  - m_Id: 438584709636096
    m_Localized: Gain {calculated_armor_value} armor per each unused temporary AP
      at the end of the turn.{armor_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 440290298191872
    m_Localized: 'Each movement leaves a sharp star on the floor.


      Sharp stars
      deal {value} damage when someone steps on it.


      Sharp stars exist for
      1 turn.'
    m_Metadata:
      m_Items: []
  - m_Id: 442140825116672
    m_Localized: 'Owner is a small unit.


      Small units can be stepped on.


      They
      die after a contact.{contact_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 443841665720320
    m_Localized: Gain {effect_value} strength for each {count} blood surfaces on
      the battlefield.{strength_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 444686738284544
    m_Localized: Leave a blood surface on death.
    m_Metadata:
      m_Items: []
  - m_Id: 445664027893760
    m_Localized: Gain {intelligence_effect_value} intelligence for each {count} picked
      up blood surfaces for {intelligence_effect_time} turns.{intelligence_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 446982255697920
    m_Localized: This effect resets at the start of each battle.
    m_Metadata:
      m_Items: []
  - m_Id: 450030566793216
    m_Localized: Gain {value} temporary AP at the start of each battle.{temporary_action_points_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 446988475850752
    m_Localized: Repel nearby units and take away from them 2 defence for 3 turn
      when health drops below {value}%.
    m_Metadata:
      m_Items: []
  - m_Id: 453947241422848
    m_Localized: Gain 1 more temporary AP for picking up a blood surface.{temporary_action_points_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 509295897763840
    m_Localized: Gain {delta_value} strength for each {step_value} missing health
      points.{strength_increased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 511690077790208
    m_Localized: 'Gain {value} temporary APwhen you step out of a cell surrounded
      by at least 1 enemy, to a cell with no enemies around it.{temporary_action_points_subhint}


      Doesn''t
      work if owner steps on a small unit.


      Works only once per turn.'
    m_Metadata:
      m_Items: []
  - m_Id: 525448175050752
    m_Localized: '


      The damage is reduced to {calculated_alternative_damage_value}
      if target is nearby.'
    m_Metadata:
      m_Items: []
  - m_Id: 527825313619968
    m_Localized: '


      The damage depends on the damage of the selected weapon.'
    m_Metadata:
      m_Items: []
  - m_Id: 534204262801408
    m_Localized: '


      If some damage was blocked during the turn of opponents,
      the damage of the next shield attack increases to {calculated_alternative_damage_value}.
      The effect is reset when receiving unblocked damage. The effect lasts for 1
      turn.{block_subhint}'
    m_Metadata:
      m_Items: []
  - m_Id: 538707611508736
    m_Localized: '


      Current damage is {calculated_current_damage_value}.'
    m_Metadata:
      m_Items: []
  - m_Id: 542127726682112
    m_Localized: '


      Increase damage of the next attack with knifes to {calculated_alternative_damage_value}
      after any kind of movement.


      The effect lasts for 1 turn.'
    m_Metadata:
      m_Items: []
  - m_Id: 544297565970432
    m_Localized: 'Deal {calculated_damage_value} damage to units within a radius
      of {range} from the owner.


      Damage to nearby units increases to {calculated_alternative_damage_value}.'
    m_Metadata:
      m_Items: []
  - m_Id: 708373805948928
    m_Localized: Throw a bite-bug to the random empty cell within a radius of {range}.
    m_Metadata:
      m_Items: []
  - m_Id: 710273305567232
    m_Localized: If lose the charge of escape from death move on the random empty
      cell.{escape_from_death_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 716854323732480
    m_Localized: 'Split into {value} small range slimes.


      They move to random
      empty cells within a radius of {range}.'
    m_Metadata:
      m_Items: []
  - m_Id: 717222453600256
    m_Localized: 'Split into {value} big range slimes and {value_2} small range slimes.


      They
      move to random empty cells within a radius of {range}.'
    m_Metadata:
      m_Items: []
  - m_Id: 718976930963456
    m_Localized: 'Split into {value} small slimes.


      They move to random empty
      cells within a radius of {range}.'
    m_Metadata:
      m_Items: []
  - m_Id: 719181369729024
    m_Localized: 'Split into {value} big slimes and {value_2} small slimes.


      They
      move to random empty cells within a radius of {range}.'
    m_Metadata:
      m_Items: []
  - m_Id: 719395845464064
    m_Localized: 'Split into {value} big slimes.


      They move to random empty
      cells within a radius of {range}.'
    m_Metadata:
      m_Items: []
  - m_Id: 723033363996672
    m_Localized: The owner is a mushroom.
    m_Metadata:
      m_Items: []
  - m_Id: 725174174507008
    m_Localized: Give {calculated_block_value} block.{block_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 726008073445376
    m_Localized: Give {calculated_armor_value} armor.{armor_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 726274210422784
    m_Localized: Give {thorns_effect_value} thorns.{thorns_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 727295141765120
    m_Localized: Take away {defence_effect_value} defence.{defence_decreased_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 728575054602240
    m_Localized: The defence effect will last for {defence_effect_time} turns.
    m_Metadata:
      m_Items: []
  - m_Id: 729628126896128
    m_Localized: Give {value} temporary AP.{temporary_action_points_subhint}
    m_Metadata:
      m_Items: []
  - m_Id: 1221999495110656
    m_Localized: Throw a toad to the starting cell.
    m_Metadata:
      m_Items: []
