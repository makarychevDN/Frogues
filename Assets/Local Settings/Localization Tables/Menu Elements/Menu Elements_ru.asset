  - m_Id: 3589714104967168
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u0431\u0435\u0433
      \u0431\u0435\u0437 \u043A\u0430\u043A\u0438\u0445-\u043B\u0438\u0431\u043E
      \u0431\u043E\u043D\u0443\u0441\u043E\u0432. \u041F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0438\u0433\u0440\u044B \u0432 \u0440\u0435\u0436\u0438\u043C\u0435 \u043E\u043F\u044B\u0442\u043D\u043E\u0439
      \u0436\u0430\u0431\u044B \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3596202319962112
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u0431\u0435\u0433
      c \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438:\n- \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F
      \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043C\u0435\u043D\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3596923308236800
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u0431\u0435\u0433
      c \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438:\n- \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F
      \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043C\u0435\u043D\u044C\u0448\u0435\n- \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435\n- \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0447\u043A\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0439\u0442\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u044C\n- \u0431\u043E\u043B\u0435\u0435
      \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435\n- \u0443 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441 \u041E\u0414 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F\n-
      \u0440\u0443\u043A\u0430\u0448\u043A\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0440\u0435\u0436\u0435\n- \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0435
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0435\u0449\u0435
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3596910125539328
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u0431\u0435\u0433
      c \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438:\n- \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F
      \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043C\u0435\u043D\u044C\u0448\u0435\n- \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435\n- \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0447\u043A\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0439\u0442\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u044C\n- \u0431\u043E\u043B\u0435\u0435
      \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435\n- \u0443 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441 \u041E\u0414 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F\n-
      \u0440\u0443\u043A\u0430\u0448\u043A\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0440\u0435\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3596885941182464
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u0431\u0435\u0433
      c \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438:\n- \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F
      \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043C\u0435\u043D\u044C\u0448\u0435\n- \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435\n- \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0447\u043A\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0439\u0442\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u044C\n- \u0431\u043E\u043B\u0435\u0435
      \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435\n- \u0443 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441 \u041E\u0414 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3596874260045824
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u0431\u0435\u0433
