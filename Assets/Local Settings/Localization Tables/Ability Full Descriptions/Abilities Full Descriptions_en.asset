  m_TableData:
  - m_Id: 92384944128
    m_Localized: 'Spends all AP. Gain {delta_value} block and {alternative_delta_value}
      armor for each spended AP.


      Gain {calculated_block_value} block and
      {calculated_armor_value} armor.'
    m_Metadata:
      m_Items: []
  - m_Id: 4971610398720
    m_Localized: 'Moves to the selected cell near the selected unit and hits it with
      the selected weapon.


      Damage of the selected weapon is {calculated_damage_value}.


      It
      costs {value_2} AP if the selected weapon is heavy. Otherwise it costs {value}
      AP.'
    m_Metadata:
      m_Items: []
  - m_Id: 12759103332352
    m_Localized: 'Moves the selected unit to the selected cell.


      The available
      area is selected in a straight line from the back of the user.'
    m_Metadata:
      m_Items: []
  - m_Id: 16880787152896
    m_Localized: Units within a radius of {range} around the owner lose {strenght_effect_value}
      strenght for {strenght_effect_time} turns.
    m_Metadata:
      m_Items: []
  - m_Id: 21818456039424
    m_Localized: Destroys the blood surface and deals {calculated_damage_value} damage
      to an area within a radius of {alternative_range} around it.
    m_Metadata:
      m_Items: []
