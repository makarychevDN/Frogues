  m_TableData:
  - m_Id: 92384944128
    m_Localized: "\u0422\u0440\u0430\u0442\u0438\u0442 \u0432\u0441\u0435 \u041E\u0414.
      \u0414\u0430\u0435\u0442 {delta_value} \u0431\u043B\u043E\u043A\u0430 \u0438
