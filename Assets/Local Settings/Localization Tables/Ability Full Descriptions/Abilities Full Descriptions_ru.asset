      \u0440\u0430\u0432\u0435\u043D {calculated_damage_value}.\n\n\u0421\u0442\u043E\u0438\u0442
      {value_2} \u041E\u0414, \u0435\u0441\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435
