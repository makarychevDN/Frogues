  - m_Id: 92384944128
    m_Localized: "\u0422\u0440\u0430\u0442\u0438\u0442 \u0432\u0441\u0435 \u041E\u0414.
      \u0414\u0430\u0435\u0442 {delta_value} \u0431\u043B\u043E\u043A\u0430 \u0438
      {alternative_delta_value} \u0431\u0440\u043E\u043D\u0438 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435 \u041E\u0414.\n\n\u0414\u0430\u0435\u0442
      {calculated_block_value} \u0431\u043B\u043E\u043A\u0430 \u0438 {calculated_armor_value}
      \u0431\u0440\u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4971610398720
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u043A\u043B\u0435\u0442\u043A\u0443
      \u0432\u043E\u0437\u043B\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u044E\u043D\u0438\u0442\u0430 \u0438 \u0431\u044C\u0435\u0442 \u0435\u0433\u043E
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u043C \u043E\u0440\u0443\u0436\u0438\u0435\u043C.\n\n\u0423\u0440\u043E\u043D
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F
      \u0440\u0430\u0432\u0435\u043D {calculated_damage_value}.\n\n\u0421\u0442\u043E\u0438\u0442
      {value_2} \u041E\u0414, \u0435\u0441\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435 \u0442\u044F\u0436\u0435\u043B\u043E\u0435.
      \u0412 \u0438\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0441\u0442\u043E\u0438\u0442
      {value} \u041E\u0414."
    m_Metadata:
      m_Items: []
  - m_Id: 12759103332352
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439
