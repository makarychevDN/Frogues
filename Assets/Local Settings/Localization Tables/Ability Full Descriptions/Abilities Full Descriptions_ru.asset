  - m_Id: 57220751581184
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 {calculated_damage_value}
      \u0443\u0440\u043E\u043D\u0430. \u0420\u0438\u043A\u043E\u0448\u0435\u0442\u0438\u0442
