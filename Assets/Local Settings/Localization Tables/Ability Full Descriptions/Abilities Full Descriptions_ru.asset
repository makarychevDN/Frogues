      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435 \u041E\u0414.\n\n\u0414\u0430\u0435\u0442
      {calculated_block_value} \u0431\u043B\u043E\u043A\u0430 \u0438 {calculated_armor_value}
      \u0431\u0440\u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4971610398720
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u043A\u043B\u0435\u0442\u043A\u0443
