  - m_Id: 9413222400
    m_Localized: "\u0416\u0430\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 68569686016
    m_Localized: "\u041D\u0435\u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0432\u043D\u044B\u0439
      \u0432\u043E\u0438\u043D \u0441 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0439
      \u043F\u0440\u043E\u0448\u043B\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 361445351424
    m_Localized: "\u0411\u0435\u0441\u043A\u043E\u043D\u0435\u043D\u0447\u043D\u043E
      \u043C\u043E\u0436\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u0442\u0440\u0438 \u0432\u0435\u0449\u0438 .\n\u041D\u043E \u043D\u0435
      \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 323189104640
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 21010977021952
    m_Localized: "\u041A\u0443\u0441\u044C-\u0436\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 21099648802816
    m_Localized: "\u041A\u0443\u0441\u044C-\u0436\u0443\u043A\u0438 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u0441\u0432\u043E\u044E \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043B\u0435\u0433\u043A\u043E
      \u043F\u0440\u0438\u0440\u0443\u0447\u0430\u044E\u0442\u0441\u044F, \u0447\u0435\u043C
      \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21616189923328
    m_Localized: "\u0420\u0443\u043A\u0430\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21661895254016
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0441\u0435\u0431\u0435
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0438, \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E
      \u0445\u0443\u0436\u0435 \u0440\u0443\u043A\u0430\u0448\u043A\u0438 \u0437\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0435\u0439
      \u0432 \u0441\u0430\u043F\u043E\u0433\u0435. \u041B\u044E\u0431\u0438\u0442
      \u043E\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C\u0438,
      \u0442\u0430\u043A \u043A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0432 \u0438\u0445 \u0442\u0435\u043D\u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22361630990336
    m_Localized: "\u041C\u043E\u0445\u043E\u0432\u0438\u0447\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 23525957197824
    m_Localized: "\u0415\u0434\u0432\u0430 \u043E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u043C\u0445\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0431\u0435\u0441\u0446\u0435\u043B\u044C\u043D\u043E \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 23778005508096
    m_Localized: "\u042F\u0449\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 24034424283136
    m_Localized: "\u0411\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0435
      \u0433\u043E\u043B\u043E\u0432\u043E\u0440\u0435\u0437\u044B, \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0435\u0441\u0442\u044C \u0432\u0442\u043E\u0440\u043E\u0439
      \u0448\u0430\u043D\u0441. \u0425\u0432\u043E\u0441\u0442\u044B \u044F\u0449\u0435\u0440\u0438\u0446
      \u0434\u0430\u044E\u0442 \u0441\u0432\u043E\u0438\u043C \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F\u043C
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u0442\u044C
      \u043E\u0442 \u0441\u043C\u0435\u0440\u0442\u0438 \u0432 \u0441\u0430\u043C\u044B\u0445
      \u0431\u0435\u0437\u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445.
      \u041E\u0442\u0442\u043E\u0433\u043E \u043E\u043D\u0438 \u043E\u0447\u0435\u043D\u044C
      \u0446\u0435\u043D\u044F\u0442\u0441\u044F \u043D\u0430 \u0447\u0435\u0440\u043D\u043E\u043C
      \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 24577465016320
    m_Localized: "\u041A\u0440\u044B\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 24776056922112
    m_Localized: "\u041B\u044E\u0431\u044F\u0442 \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u044C
      \u0442\u043E\u043B\u043F\u043E\u0439 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0433\u0440\u044F\u0437\u043D\u044B\u0435 \u043F\u0440\u0438\u0435\u043C\u044B.
      \u0421\u043B\u0430\u0431\u044B\u0435 \u043F\u043E\u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0435,
      \u043D\u0430\u0433\u043B\u0435\u044E\u0442 \u043F\u043E \u043C\u0435\u0440\u0435
      \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043D\u0430 \u043F\u043E\u043B\u0435
      \u0431\u043E\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043A\u0440\u044B\u0441\u044B. \u041E\u043D\u0438
      \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0441\u0442\u0430\u0442\u044C
      \u0431\u0438\u0447\u043E\u043C \u0432\u0441\u0435\u0439 \u043E\u043A\u0440\u0443\u0433\u0438,
      \u043D\u043E \u0438\u0445 \u043F\u043E\u0434\u043B\u043E\u0441\u0442\u044C
      \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0442\u0435\u043C, \u0447\u0442\u043E \u0443 \u043D\u0438\u0445 \u043E\u0434\u043D\u0430
      \u043E\u0431\u0449\u0430\u044F \u0438\u0437\u0432\u0438\u043B\u0438\u043D\u0430
      \u043D\u0430 \u0432\u0441\u044E \u0438\u0445 \u043A\u0440\u044B\u0441\u0438\u043D\u0443\u044E
      \u043A\u043E\u043C\u043C\u0443\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25263867060224
    m_Localized: "\u041A\u0440\u044B\u0441\u044B \u0442\u0430\u043A \u0438 \u043D\u0435
      \u043D\u0430\u0443\u0447\u0438\u043B\u0438\u0441\u044C \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0438\u0437\u0430\u0446\u0438\u0438,
      \u043E\u0442 \u0442\u043E\u0433\u043E \u0443 \u043D\u0438\u0445 \u0438\u043D\u043E\u0433\u0434\u0430
      \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442 \u0442\u0430\u043A\u0438\u0435
      \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u043A\u0430\u0434\u0440\u044B.
      \u042D\u0442\u043E \u043D\u0438 \u043F\u0440\u0438 \u043A\u0430\u043A\u0438\u0445
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
      \u0431\u044B\u043B\u043E \u0431\u044B\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u043E\u0439
      \u0435\u0434\u0438\u043D\u0438\u0446\u0435\u0439, \u043D\u043E \u043E\u043D
      \u0432\u043D\u0443\u0448\u0430\u0435\u0442 \u0441\u0432\u043E\u0438\u043C \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0435\u043C
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u043C\u044B\u0441\u043B\u0438\u043C\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 27189249728512
    m_Localized: "\u041A\u0443\u0441\u043E\u0447\u0435\u043A \u0441\u043B\u0438\u0437\u044C\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 27310398005248
    m_Localized: "\u041A\u0443\u0441\u043E\u0447\u0435\u043A \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u043E\u0433\u043E
      \u0441\u043B\u0438\u0437\u044C\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 27817434832896
    m_Localized: "\u0421\u043B\u0438\u0437\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 27843418546176
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0439
      \u0441\u043B\u0438\u0437\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31161712795648
    m_Localized: "\u041A\u0440\u0443\u043F\u043D\u044B\u0439 \u0441\u043B\u0438\u0437\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31292889653248
    m_Localized: "\u041A\u0440\u0443\u043F\u043D\u044B\u0439 \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0439
      \u0441\u043B\u0438\u0437\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31641230794752
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432\u044B\u0439 \u0441\u043B\u0438\u0437\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31953559642112
    m_Localized: "\u041C\u043D\u043E\u0433\u0438\u0435 \u043D\u0430\u0438\u0432\u043D\u043E
      \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442, \u0447\u0442\u043E,
      \u0440\u0430\u0437\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u043F\u043E\u043B\u0430\u043C
      \u0441\u043B\u0438\u0437\u0435\u043D\u044C - \u044D\u0442\u043E \u0447\u0438\u0441\u0442\u0430\u044F
      \u0438 \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u043F\u043E\u0431\u0435\u0434\u0430.
      \u0416\u0430\u043B\u044C \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 32687722225664
    m_Localized: "\u0411\u0435\u0437\u043C\u043E\u0437\u0433\u043B\u043E\u0435, \u043D\u043E
      \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
      \u043F\u043E\u043B\u0437\u0435\u0442 \u043A \u0441\u0432\u043E\u0435\u0439
      \u0446\u0435\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u0442\u044C\u0441\u044F
      \u0441 \u043D\u0435\u0439. \u041F\u043E\u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F, \u0435\u0441\u043B\u0438
      \u0432 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442,
      \u0447\u0442\u043E \u0435\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      \u0443\u043F\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33000831213568
    m_Localized: "\u0427\u0435\u0440\u0435\u043F\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33296814858240
    m_Localized: "\u0410\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0439
      \u0432\u043E\u0438\u0442\u0435\u043B\u044C. \u0427\u0435\u0440\u0435\u043F\u0430\u0445\u0438,
      \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0438\u0435 \u043A \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438, \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0442
      \u043F\u043E\u043B\u0430\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33243178098688
    m_Localized: "\u0428\u0438\u043F\u0430\u0441\u0442\u0430\u044F \u0447\u0435\u0440\u0435\u043F\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33968624918528
    m_Localized: "\u0413\u0440\u0438\u0431\u043E\u043D\u043E\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 34212657913856
    m_Localized: "\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u044E\u043D\u0438\u0442\u043E\u0432
      \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u044F. \u0421\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0433\u0440\u0438\u0431\u044B \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0438\u0441\u044C,
      \u0447\u0442\u043E \u0436\u0438\u0432\u044B\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0443\u0442 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044E
      \u0441\u043F\u043E\u0440, \u0435\u0441\u043B\u0438 \u0441\u043F\u043E\u0440\u044B
      \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C,
      \u0430 \u043D\u0435 \u0432\u0440\u0435\u0434\u0438\u0442\u044C. \u0412\u043F\u0440\u043E\u0447\u0435\u043C,
      \u0443 \u0433\u0440\u0438\u0431\u043E\u0432 \u0438 \u0446\u0435\u043B\u0438
      \u0442\u0435\u043F\u0435\u0440\u044C \u0438\u043D\u044B\u0435. \u041D\u0435
