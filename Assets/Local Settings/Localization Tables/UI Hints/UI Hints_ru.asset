      \u043D\u0430 {sum_value}%."
    m_Metadata:
      m_Items: []
  - m_Id: 48874543800320
    m_Localized: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
