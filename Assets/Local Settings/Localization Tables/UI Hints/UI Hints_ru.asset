      \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      {step_value}% \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0443\u044E
