  - m_Id: 51118060232704
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0433\u0430\u043C, \u0447\u0442\u043E
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u043B\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430.
      \u041E\u0442\u0432\u0435\u0442\u043D\u044B\u0439 \u0443\u0440\u043E\u043D \u0440\u0430\u0432\u0435\u043D
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E \u0448\u0438\u043F\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 52846801346560
    m_Localized: "\u0417\u0430\u043F\u0440\u0435\u0449\u0430\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043D\u0430
      {value} \u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1476625737867264
    m_Localized: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0447\u043A\u043E\u0432
      \u0432\u044B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435,
      \u0442\u0435\u043C \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0441\u0442\u0430\u043D\u0435\u0442
      \u0436\u0430\u0431\u0430, \u043D\u043E \u0442\u0435\u043C \u043E\u043F\u0430\u0441\u043D\u0435\u0435
      \u0441\u0442\u0430\u043D\u0443\u0442 \u0432\u0440\u0430\u0433\u0438. \u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
      \u0441\u0447\u0435\u0442\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0439\u0442\u0438
      \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C \u0432 \u043B\u0430\u0433\u0435\u0440\u044C.\n\n\u0414\u043B\u044F
      \u043F\u043E\u0431\u0435\u0434\u044B \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043D\u0430\u0431\u0440\u0430\u0442\u044C 1500 \u043E\u0447\u043A\u043E\u0432,
      \u0434\u043E\u0439\u0442\u0438 \u0434\u043E \u043B\u0430\u0433\u0435\u0440\u044F
      \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
