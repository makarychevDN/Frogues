  m_TableData:
  - m_Id: 51448537088
    m_Localized: Until next turn, prevents damage.
    m_Metadata:
      m_Items: []
  - m_Id: 13085877362688
    m_Localized: Prevents damage. Stays with the owner until the end of a fight.
    m_Metadata:
      m_Items: []
  - m_Id: 13629052313600
    m_Localized: 'Incoming damage is increased by {step_value}% for each missing
      protection point.


      The current value is {value}, incoming damage is
      increased by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 36729806544896
    m_Localized: 'Incoming damage is reduced by {step_value}% for each protection
      point.


      The current value is {value}, incoming damage is reduced by
      {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 38610217885696
    m_Localized: 'Block received from the owner''s abilities is reduced by {step_value}%
      for each missing dexterity point.


      The current value is {value}, outgoing
      block is reduced by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 43400985468928
    m_Localized: 'Block received from the owner''s abilities is increased by {step_value}%
      for each dexterity point.


      The current value is {value}, outgoing block
      is increased by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 46958849974272
    m_Localized: 'Elemental and bloody damage from the owner''s abilities is reduced
      by {step_value}% for each missing point of intelligence.


      The current
      value is {value}, outgoing damage is reduced by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 48874543800320
    m_Localized: 'Elemental and bloody damage from the owner''s abilities is increased
      by {step_value}% for each point of intelligence.


      The current value
      is {value}, outgoing damage is reduced by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 49737320521728
    m_Localized: 'Physical and bloody damage from the owner''s abilities is reduced
      by {step_value}% for each missing point of strenght.


      The current value
      is {value}, outgoing damage is reduced by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 50195422404608
    m_Localized: 'Physical and bloody damage from the owner''s abilities is increased
      by {step_value}% for each point of strenght.


      The current value is {value},
      outgoing damage is increased by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 51118060232704
    m_Localized: Deals damage to a owner's attacker when hit. Dealed damage is equal
      to the value of thorns.
    m_Metadata:
      m_Items: []
  - m_Id: 52846801346560
    m_Localized: Forbides to use movement for {value} turns.
    m_Metadata:
      m_Items: []
  - m_Id: 1476625737867264
    m_Localized: 'The more score you earn, the stronger the toad will become, but
      the more dangerous the enemies will become. Increasing the score brings closer
      the opportunity to go to rest in the camp.


      To win, you need to score
      1,500 points, reach the camp and complete the final test.'
    m_Metadata:
      m_Items: []
  - m_Id: 1479204916060160
    m_Localized: Score
