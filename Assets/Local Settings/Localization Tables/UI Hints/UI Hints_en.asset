  - m_Id: 13629052313600
    m_Localized: 'Incoming damage is increased by {step_value}% for each missing
      defence point.


      The current value is {value}, incoming damage is increased
      by {sum_value}%.'
    m_Metadata:
      m_Items: []
  - m_Id: 36729806544896
